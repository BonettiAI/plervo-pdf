diff --git a/crates/ui-egui/tests/plervo_identity.rs b/crates/ui-egui/tests/plervo_identity.rs
new file mode 100644
index 0000000..27738b4
--- /dev/null
+++ b/crates/ui-egui/tests/plervo_identity.rs
@@ -0,0 +1,35 @@
+//! The product identity must remain visible even in a narrow workbook window.
+use egui::{FontDefinitions, FontFamily, Rect, Shape, pos2, vec2};
+use gridcraft_engine::Session;
+use gridcraft_ui_egui::{SheetApp, ribbon, theme};
+
+#[test]
+fn product_name_is_visible_in_narrow_and_wide_title_bars() {
+    for width in [640.0, 1440.0] {
+        for dark in [false, true] {
+            let ctx = egui::Context::default();
+            ctx.set_visuals(if dark { egui::Visuals::dark() } else { egui::Visuals::light() });
+            let mut fonts = FontDefinitions::default();
+            let fallback = fonts.families.get(&FontFamily::Proportional).cloned().unwrap_or_default();
+            for role in [theme::UI, theme::UI_BOLD] {
+                fonts.families.insert(FontFamily::Name(role.into()), fallback.clone());
+            }
+            ctx.set_fonts(fonts);
+            let mut session = Session::new();
+            session.new_workbook();
+            session.active_mut().expect("new workbook").path = Some(format!("/{} Budget.xlsx", "Quarterly ".repeat(30)));
+            let mut app = SheetApp::new(session, Default::default());
+            let mut output = ctx
+                .run_ui(egui::RawInput { screen_rect: Some(Rect::from_min_size(pos2(0.0, 0.0), vec2(width, 420.0))), ..Default::default() }, |ui| {
+                    ribbon::title_bar(&mut app, ui)
+                });
+            output.textures_delta.clear();
+            let name = output.shapes.iter().find_map(|shape| match &shape.shape {
+                Shape::Text(text) if text.galley.job.text == "Plervo Sheets" => Some((shape.clip_rect, text)),
+                _ => None,
+            });
+            let (clip, name) = name.expect("the rendered main window must identify Plervo Sheets");
+            assert!(clip.contains_rect(name.galley.rect.translate(name.pos.to_vec2())), "product name must not be clipped at width {width}");
+        }
+    }
+}
